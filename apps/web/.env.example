# Public rights-safe release mode. Renders only derived diagnostics and no raw observations.
DATA_MODE=derived_only

# Canonical production origin used for metadata, robots.txt, and sitemap.xml.
# Set this to the exact deployed HTTPS origin for Release 1.
NEXT_PUBLIC_SITE_URL=

# Exact deployed Git commit. CI sets this explicitly; Vercel deployments may use
# VERCEL_GIT_COMMIT_SHA instead. The public release manifest must never remain UNBOUND.
RELEASE_COMMIT_SHA=

# Release 1 has no third-party analytics or client-side monitoring SDK.
# Do not add analytics/monitoring keys without updating the production policy and audit.

# Private local research mode. Requires data/audit/private/rps_subgroup_5q_audit.json.
# DATA_MODE=audit_snapshot

# Reserved for a future reviewed server-side adapter. Currently fails closed.
# DATA_MODE=fred_live_no_store
# FRED_API_KEY=
